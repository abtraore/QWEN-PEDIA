+    for layer in (layer0, layer1):
+        assert layer._mmap_staging is not None
+        assert layer._mmap_staging.shape == (32, layer.ngram_heads, layer.head_dim)
+    assert layer0._mmap_staging.data_ptr() != layer1._mmap_staging.data_ptr()
