+        table = _readahead_table(tmp_path, readahead)
+        gathered.append(torch.from_numpy(table.gather(ids)).view(torch.float8_e4m3fn))
+        runs = table._latencies_ms[-1][3]
+        assert runs > 0 if readahead else runs == 0
+        table.close()
