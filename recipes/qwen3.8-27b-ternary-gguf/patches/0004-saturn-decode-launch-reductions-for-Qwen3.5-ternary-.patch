+    // saturn: dual-output matvec. Two batch-1 MUL_MATs that read the SAME input through same-shape,
+    // same-type weights and are separated only by no-op nodes (reshape/view of the first result) run as
+    // one launch: ssm_alpha + ssm_beta (bf16, 48 rows, launch-bound at ~4 us each) and attn_k + attn_v on
+    // Qwen3.5. Placed last so it never takes a pair that belongs to the gate/up/GLU fusion.
+    static const bool dual_matvec = getenv("GGML_CUDA_FUSE_DUAL_MATVEC") == nullptr || std::atoi(getenv("GGML_CUDA_FUSE_DUAL_MATVEC")) != 0;
+    if (dual_matvec && node->op == GGML_OP_MUL_MAT && node->ne[1] == 1 && node->ne[2] == 1 && node->ne[3] == 1) {
+        const auto is_noop = [](const ggml_tensor * t) {
+            return ggml_is_empty(t) || t->op == GGML_OP_NONE || t->op == GGML_OP_RESHAPE || t->op == GGML_OP_TRANSPOSE ||
+                   t->op == GGML_OP_VIEW || t->op == GGML_OP_PERMUTE;
+        };
+        int j = i + 1;
+        while (j < cgraph->n_nodes && j - i <= 4 && is_noop(cgraph->nodes[j])) {
+            ++j;
+        }
+        ggml_tensor * other = j < cgraph->n_nodes ? cgraph->nodes[j] : nullptr;
+        if (other && other->op == GGML_OP_MUL_MAT && other->src[1] == node->src[1] && other != node->src[1] &&
+            other->src[0]->type == node->src[0]->type && ggml_are_same_shape(other->src[0], node->src[0]) &&
+            ggml_are_same_stride(other->src[0], node->src[0]) && ggml_are_same_shape(other, node) &&
+            other->src[0]->op == GGML_OP_NONE && node->src[0]->op == GGML_OP_NONE) {
+            const bool use_q = ggml_cuda_should_fuse_mul_mat_vec_q(node) && ggml_cuda_should_fuse_mul_mat_vec_q(other);
+            const bool use_f = !use_q && ggml_cuda_should_fuse_mul_mat_vec_f(node) && ggml_cuda_should_fuse_mul_mat_vec_f(other);
+            const auto overlap = [](const ggml_tensor * a, const ggml_tensor * b) {
+                const int64_t a0 = (int64_t) a->data, a1 = a0 + (int64_t) ggml_backend_buft_get_alloc_size(a->buffer->buft, a);
+                const int64_t b0 = (int64_t) b->data, b1 = b0 + (int64_t) ggml_backend_buft_get_alloc_size(b->buffer->buft, b);
+                return a0 < b1 && b0 < a1;
+            };
+            // the two results must be distinct; the float kernel reads src1 while it writes, the quantized
+            // one only reads its private q8_1 copy
+            bool mem_ok = !overlap(node, other);
