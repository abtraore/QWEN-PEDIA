+++ b/ggml/src/ggml-cuda/common.cuh
@@ -1465,6 +1465,18 @@ struct ggml_backend_cuda_context {
 
     int curr_stream_no = 0;
 
+    // saturn: per-graph cache of q8_1-quantized batch-1 activations. Several mmvq consumers often read the
+    // SAME tensor (qkv + gate, q + k/v, ...) and each used to launch its own quantize kernel (~2.6 us,
+    // launch-bound). Entries live in a small persistent arena (not the scratch pool: that one is
+    // stack-like and a cached buffer would break its LIFO free order). Reset at the start of every
+    // graph evaluation; addresses are stable, so captured CUDA graphs replay correctly.
+    struct saturn_q8_entry { const ggml_tensor * src1; const void * src_data; int type; char * data; size_t size; };
+    long saturn_q8_hits = 0;
+    std::vector<saturn_q8_entry> saturn_q8_cache;
+    char * saturn_q8_arena      = nullptr;
+    size_t saturn_q8_arena_size = 0;
+    size_t saturn_q8_arena_used = 0;
+
 #ifdef USE_CUDA_GRAPH
     // Map from first_node_ptr to cuda_graph - allows multiple graphs per context
     // when the computation is split across CPU/GPU (e.g., with --n-cpu-moe)
@@ -1580,6 +1592,9 @@ struct ggml_cuda_mm_fusion_args_host {
     const ggml_tensor * x_scale = nullptr;
     const ggml_tensor * gate_scale = nullptr;
     ggml_glu_op glu_op;
+    // saturn: dual-output matvec. When set, `gate` is a SECOND weight applied to the same input and its
+    // result is written to dst2 instead of being combined through the GLU (two projections, one launch).
+    const ggml_tensor * dst2 = nullptr;
 };
 struct ggml_cuda_mm_fusion_args_device {
     const void * x_bias = nullptr;
@@ -1588,6 +1603,7 @@ struct ggml_cuda_mm_fusion_args_device {
     const void * x_scale = nullptr;
     const void * gate_scale = nullptr;
     ggml_glu_op glu_op;
+    float * dst2 = nullptr; // saturn: dual-output matvec, see ggml_cuda_mm_fusion_args_host
 };
 
