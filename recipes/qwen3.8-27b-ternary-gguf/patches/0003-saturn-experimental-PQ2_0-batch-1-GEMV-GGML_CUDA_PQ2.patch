+        if (pq2_smallk && type == GGML_TYPE_PQ2_0 && table_id == MMVQ_PARAMETERS_GENERIC && c_ncols_dst == 1 && nwarps > 1) {
+            use = true;
+        }
 
         constexpr std::array<ggml_type, 2> iq_slow_turing = {
             GGML_TYPE_IQ3_XXS,
@@ -1464,6 +1472,12 @@ void ggml_cuda_mul_mat_vec_q(
 
     const int64_t ids_stride = ids ? ids->nb[1] / ggml_type_size(ids->type) : 0;
 
