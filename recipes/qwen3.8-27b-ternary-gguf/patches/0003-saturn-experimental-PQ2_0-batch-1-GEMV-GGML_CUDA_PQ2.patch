@@ -1030,6 +1031,13 @@ static void mul_mat_vec_q_switch_ncols_dst(
         if (GGML_CUDA_CC_IS_CDNA(cc) && (type == GGML_TYPE_Q1_0 || type == GGML_TYPE_Q2_0 || type == GGML_TYPE_PQ2_0)) {
             use = false;
         }
+        // saturn experiment E2: one warp per row (rows_per_block = nwarps) for PQ2_0 batch-1 on the generic
